@using MudBlazor
@inherits LayoutComponentBase
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<MudThemeProvider @bind-IsDarkMode="@_isDarkMode" Theme="_theme" @ref="_mudThemeProvider" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout Class="@($"shift-docs{(_isDarkMode ? " shift-dark" : "")}")">
    @* Uses the palette's translucent AppbarBackground so scrolled content is tinted and blurred behind the header. *@
    <MudAppBar Class="docs-appbar-filter" Elevation="0"></MudAppBar>
    <MudAppBar Color="Color.Transparent" Class="docs-appbar" Elevation="0">
        <div style="padding: 8px 28px;" class="d-flex align-center flex-grow-1 d-md-none">
            <MudIconButton OnClick="@(() => _drawerOpen = !_drawerOpen)" Icon="@Icons.Material.Rounded.Notes" Color="Color.Inherit" Edge="Edge.Start" aria-label="Toggle drawer" />
            <MudSpacer />
            <a href="/" class="d-flex align-center">
                <MudImage Src="@LogoSrc" Alt="Shift Software" Height="16" Class="pe-5" />
            </a>
            <MudSpacer />
            <MudToggleIconButton @bind-Toggled="_isDarkMode" Icon="@Icons.Material.Filled.WbSunny" Color="@Color.Primary" ToggledIcon="@Icons.Material.Filled.DarkMode" aria-label="Toggle dark mode" />
        </div>

        <div style="padding: 8px 28px;" class="d-none d-md-flex align-center flex-grow-1">
            <a href="/" class="d-flex align-center me-4">
                <MudImage Src="@LogoSrc" Alt="Shift Software" Height="18" Class="pe-5" />
            </a>

            <MudButton Href="/" Color="Color.Inherit" Variant="Variant.Text" Class="@GetActiveClass(IsHomePage)">Home</MudButton>
            @* Doc pages live under several roots (/docs, /get-started, /concepts, ...), so Docs is active everywhere except Home. *@
            <MudButton Href="/docs" Color="Color.Inherit" Variant="Variant.Text" Class="@GetActiveClass(!IsHomePage)">Docs</MudButton>
            <MudMenu Color="Color.Inherit" Variant="Variant.Text" Class="mx-1 px-3" PopoverClass="docs-layout-menu-shadow" ListClass="d-flex px-4 pb-2 docs-appbar-special-menu" LockScroll="true" Label="Projects" EndIcon="@Icons.Material.Filled.KeyboardArrowDown" AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter">
               @*  <MudList T="string">
                    <MudListItem Href="/mud/introduction">
                        <div class="d-flex">
                            <MudText Color="Color.Primary">Shift Blazor</MudText>
                        </div>
                        <MudText Typo="Typo.body2">What is Shift Blazor?</MudText>
                    </MudListItem>
                </MudList> *@
                <MudList T="string" Class="relative">
                    <MudListItem Href="https://github.com/ShiftSoftware/TypeAuth">
                        <div class="d-flex">
                            <MudText>Type Auth</MudText>
                        </div>
                        <MudText Typo="Typo.body2">Role-based authorization.</MudText>
                    </MudListItem>
                 </MudList>
            </MudMenu>

            <MudSpacer />

            <MudToggleIconButton @bind-Toggled="_isDarkMode" Icon="@Icons.Material.Filled.WbSunny" Color="@Color.Primary" ToggledIcon="@Icons.Material.Filled.DarkMode" aria-label="Toggle dark mode" />

        </div>
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen"
               ClipMode="DrawerClipMode.Docked"
               Elevation="0"
               Breakpoint="Breakpoint.Md"
               Variant="DrawerVariant.Responsive"
               aria-label="Navigation Drawer">
        <NavMenu />
    </MudDrawer>
    <MudMainContent>
        <MudContainer Class="pb-10" MaxWidth="MaxWidth.False">
            @Body
        </MudContainer>
    </MudMainContent> 
    <MudScrollToTop TopOffset="400" Style="z-index:2000;">
        <MudFab StartIcon="@Icons.Material.Filled.KeyboardArrowUp" Color="Color.Primary" />
    </MudScrollToTop> 

</MudLayout>


<style>
    .docs-appbar-filter {
        z-index: 1301;
        backdrop-filter: blur(12px);
    }

    .docs-appbar {
        z-index: 1301;
    }

    .docs-appbar .mud-autocomplete,
    .docs-menu-list .mud-autocomplete {
        max-width: 360px;
    }

    .docs-appbar .mud-button,
    .docs-menu-list .mud-button {
        font-family: 'Public Sans', 'Roboto', 'Arial', 'sans-serif';
        font-size: .875rem;
        font-weight: 500;
        line-height: 1.75;
        letter-spacing: .02857em;
        text-transform: none;
    }

    /* Widen the docs nav drawer so long page titles fit on one line. */
    .mud-drawer.mud-drawer-responsive {
        width: 280px;
    }

    /* Page-status indicator dot prefixed before each nav link's title. */
    .nav-status-dot {
        display: inline-block;
        width: 7px;
        height: 7px;
        border-radius: 50%;
        margin-right: 8px;
        vertical-align: middle;
        flex-shrink: 0;
    }

    .nav-status-draft {
        background-color: var(--mud-palette-warning);
    }

    .nav-status-reviewed {
        background-color: var(--mud-palette-info);
    }

</style>

@code {
    private string GetActiveClass(bool isActive)
    {
        return isActive ? "mud-chip-text mud-chip-color-primary mx-1 px-3" : "mx-1 px-3";
    }

    private string LogoSrc => _isDarkMode ? "shift-dark.png" : "shift.png";

    private bool _isDarkMode;
    private bool _drawerOpen = true;
    private MudThemeProvider? _mudThemeProvider;
    // Brand yellow (#F8CA4D) is unreadable as text on white (~1.6:1), and MudBlazor
    // uses Primary as a text color for links, the active nav item and icons. The
    // light palette therefore uses a darker gold of the same hue, and darkens the
    // semantic colors so callout text and status chips pass WCAG AA. The dark palette
    // keeps brand yellow but switches contrast text to dark, since white on yellow
    // is unreadable too.
    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight()
        {
            Primary = "#8A6500",
            PrimaryContrastText = "#FFFFFF",
            Info = "#1976D2",
            Success = "#2E7D32",
            Warning = "#C05600",
            Error = "#D32F2F",
            AppbarBackground = "rgba(255, 255, 255, 0.8)",
        },
        PaletteDark = new PaletteDark()
        {
            Primary = "#F8CA4D",
            PrimaryContrastText = "rgba(0, 0, 0, 0.87)",
            InfoContrastText = "rgba(0, 0, 0, 0.87)",
            SuccessContrastText = "rgba(0, 0, 0, 0.87)",
            WarningContrastText = "rgba(0, 0, 0, 0.87)",
            ErrorContrastText = "rgba(0, 0, 0, 0.87)",
            AppbarBackground = "rgba(50, 51, 61, 0.8)",
        },
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _mudThemeProvider != null)
        {
            _isDarkMode = await _mudThemeProvider.GetSystemDarkModeAsync();
            StateHasChanged();
        }

        // Keep Prism's dark theme stylesheet in sync with the current dark mode
        // state. Cheap and idempotent — runs on every render.
        await JS.InvokeVoidAsync("setPrismDarkTheme", _isDarkMode);
    }

    private bool IsHomePage =>
    string.IsNullOrEmpty(NavigationManager.ToBaseRelativePath(NavigationManager.Uri).TrimEnd('/'));
}